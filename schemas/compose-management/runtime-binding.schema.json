{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://vigara.io/schemas/compose-management/runtime-binding-v1.json","title":"Vigara runtime profile-agent binding v1 (database state)","type":"object","additionalProperties":false,"required":["apiVersion","kind","profileId","agentId","ownershipEpoch","status","boundAt"],"properties":{"apiVersion":{"const":"vigara.io/v1"},"kind":{"const":"RuntimeBinding"},"profileId":{"$ref":"#/$defs/id"},"agentId":{"type":"string","minLength":1,"maxLength":128},"ownershipEpoch":{"type":"integer","minimum":1},"status":{"enum":["active","revoking","revoked"]},"boundAt":{"type":"string","format":"date-time"},"revokedAt":{"type":"string","format":"date-time"},"lastHeartbeatAt":{"type":"string","format":"date-time"}},"$defs":{"id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$","maxLength":63}}}
