VIGIRA_ADDR=:8080
VIGIRA_DATABASE_URL=postgres://vigira:vigira@localhost:5432/vigira?sslmode=disable
VIGIRA_COOKIE_SECURE=false
POSTGRES_DB=vigira
POSTGRES_USER=vigira
POSTGRES_PASSWORD=vigira

# Telemetry keeps 48 hours of raw samples for alert windows up to 24 hours, plus hourly rollups for 90 days.
VIGIRA_TELEMETRY_RAW_RETENTION_HOURS=48
VIGIRA_TELEMETRY_ROLLUP_RETENTION_DAYS=90

# Android file uploads are disabled unless this private local/network root is set.
# Keep the directory writable only by the Vigara API service account and include it in server recovery.
# VIGIRA_ANDROID_BACKUP_ROOT=/srv/vigara/android-files
# Per-file limit is 512 MiB by default (allowed range: 1 MiB..2 GiB).
VIGIRA_ANDROID_BACKUP_MAX_FILE_BYTES=536870912
# Aggregate stored + in-flight file limit is 100 GiB by default.
VIGIRA_ANDROID_BACKUP_MAX_TOTAL_BYTES=107374182400

# Optional agent-side Synology DS923+ monitoring over a restricted, read-only SNMP v2c community.
# Set both variables in the Vigira agent service environment; the NAS is queried with a two-second bound.
# Keep the community value private and restrict SNMP access to the agent or management network.
# VIGIRA_SYNOLOGY_SNMP_TARGET=192.0.2.23:161
# VIGIRA_SYNOLOGY_SNMP_COMMUNITY=replace-with-dedicated-read-community

# Optional alert delivery. Leave these unset to disable each destination.
# Gotify uses an application token; tokens are sent in a header.
# VIGIRA_GOTIFY_URL=https://gotify.example.com
# VIGIRA_GOTIFY_TOKEN=replace-with-application-token
# Discord uses an incoming webhook; keep its entire URL private.
# VIGIRA_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/WEBHOOK_ID/WEBHOOK_TOKEN
