VIGARA_ADDR=:8080
VIGARA_DATABASE_URL=postgres://vigira:vigira@localhost:5432/vigira?sslmode=disable
VIGARA_COOKIE_SECURE=false
POSTGRES_DB=vigira
POSTGRES_USER=vigira
POSTGRES_PASSWORD=vigira

# Telemetry keeps 30 days of raw samples, then hourly summaries up to 365 days total.
VIGIRA_TELEMETRY_RAW_RETENTION_HOURS=720
VIGIRA_TELEMETRY_ROLLUP_RETENTION_DAYS=365

# Android file uploads are disabled unless this private local/network root is set.
# Keep the directory writable only by the Vigara API service account and include it in server recovery.
# VIGARA_ANDROID_BACKUP_ROOT=/srv/vigara/android-files
# Per-file limit is 512 MiB by default (allowed range: 1 MiB..2 GiB).
VIGARA_ANDROID_BACKUP_MAX_FILE_BYTES=536870912
# Aggregate stored + in-flight file limit is 100 GiB by default.
VIGARA_ANDROID_BACKUP_MAX_TOTAL_BYTES=107374182400

# Optional agent-side Synology DS923+ monitoring over a restricted, read-only SNMP v2c community.
# Set both variables in the Vigara agent service environment; the NAS is queried with a two-second bound.
# Keep the community value private and restrict SNMP access to the agent or management network.
# VIGARA_SYNOLOGY_SNMP_TARGET=192.0.2.23:161
# VIGARA_SYNOLOGY_SNMP_COMMUNITY=replace-with-dedicated-read-community

# Alert channels (ntfy, Gotify, Discord) are added under Settings > Notifications.
# Their tokens are encrypted with this key; generate it with: openssl rand -base64 32
# Older VIGIRA_NTFY_*, VIGIRA_GOTIFY_* and VIGIRA_DISCORD_WEBHOOK_URL settings are
# imported once when the key is first set, then ignored (docs/notification-channels.md).
# VIGIRA_NOTIFICATION_MASTER_KEY=replace-with-32-random-bytes-in-base64

# Optional Git-backed Compose stack management (see docs/git-backed-stacks.md).
# Initialize the remote branch with at least one commit before connecting it.
# VIGIRA_STACK_GIT_URL=ssh://git@example.com/home/compose-stacks.git
# VIGIRA_STACK_GIT_BRANCH=main
# VIGIRA_STACK_GIT_DIR=/var/lib/vigira/stacks.git
# VIGIRA_STACK_TARGETS_FILE=/etc/vigira/stack-targets.json
# VIGIRA_SOPS_BINARY=/usr/bin/sops
# Optional Claude/ChatGPT MCP server (API server only; see docs/mcp.md).
# Leave unset to disable. Use the public HTTPS origin without /mcp.
# VIGIRA_MCP_URL=https://vigara.example.com

# Agent only:
# VIGIRA_COMPOSE_TARGETS_FILE=/etc/vigira/compose-targets.json
# VIGIRA_COMPOSE_AGE_IDENTITY=/etc/vigira/keys/target-age.txt

# Managed device backups: base64-encoded random 32-byte key. Back up separately.
VIGIRA_BACKUP_MASTER_KEY=
# Optional standalone-server restic path; Docker includes the pinned executable.
VIGIRA_RESTIC_EXECUTABLE=

# Native GitHub App registration: generated by deploy/setup.sh.
# Use the canonical HTTPS origin and keep this key across restarts.
# Generate manually: openssl rand -base64 32; back up separately from PostgreSQL.
# VIGIRA_GITHUB_APP_MASTER_KEY=
