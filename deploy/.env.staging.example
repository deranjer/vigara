POSTGRES_DB=vigira
POSTGRES_USER=vigira
POSTGRES_PASSWORD=replace-with-a-long-random-password
VIGARA_PORT=8080
VIGARA_COOKIE_SECURE=false
# Optional: uncomment to enable Android file uploads. Stored in the persistent android-backups volume.
# VIGARA_ANDROID_BACKUP_ROOT=/var/lib/vigira/android-backups
# Optional override, for example a pinned commit SHA:
# VIGARA_IMAGE=ghcr.io/deranjer/vigara:sha-0123456789ab
# Agent bundle downloads are optional; see compose.staging.downloads.example.yml.
# VIGARA_AGENT_RELEASE_HOST_DIR=./agent-releases
# VIGARA_PUBLIC_URL=https://vigara.example
# Additional addresses agents may use (comma-separated), e.g. a Tailscale address.
# VIGARA_PUBLIC_URLS=https://vigara.tailnet-name.ts.net
# Trusted private network only: allow http:// URLs for LAN, Tailscale, or .local addresses.
# Agent credentials and telemetry are then unencrypted on the wire.
# VIGARA_ALLOW_INSECURE_AGENT_HTTP=true
# Optional OAuth-protected MCP endpoint for Claude and ChatGPT. Set the external
# HTTPS origin without /mcp; see docs/mcp.md. Leave unset to disable.
# VIGARA_MCP_URL=https://vigara.example.com
