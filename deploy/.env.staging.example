POSTGRES_DB=vigira
POSTGRES_USER=vigira
POSTGRES_PASSWORD=replace-with-a-long-random-password
VIGIRA_PORT=8080
VIGIRA_COOKIE_SECURE=false
# Optional: uncomment to enable Android file uploads. Stored in the persistent android-backups volume.
# VIGIRA_ANDROID_BACKUP_ROOT=/var/lib/vigira/android-backups
# Optional override, for example a pinned commit SHA:
# VIGIRA_IMAGE=ghcr.io/deranjer/vigara:sha-0123456789ab
# Agent bundle downloads are optional; see compose.staging.downloads.example.yml.
# VIGIRA_AGENT_RELEASE_HOST_DIR=./agent-releases
# VIGIRA_PUBLIC_URL=https://vigara.example
# Published images fetch same-commit agent assets automatically. Set off to disable.
VIGIRA_AGENT_RELEASE_TAG=auto
# Additional addresses agents may use (comma-separated), e.g. a Tailscale address.
# VIGIRA_PUBLIC_URLS=https://vigara.tailnet-name.ts.net
# Trusted private network only: allow http:// URLs for LAN, Tailscale, or .local addresses.
# Agent credentials and telemetry are then unencrypted on the wire.
# VIGIRA_ALLOW_INSECURE_AGENT_HTTP=true
# Optional OAuth-protected MCP endpoint for Claude and ChatGPT. Set the external
# HTTPS origin without /mcp; see docs/mcp.md. Leave unset to disable.
# VIGIRA_MCP_URL=https://vigara.example.com

# Native GitHub App registration: generated by deploy/setup.sh.
# Use the canonical HTTPS origin and keep this key across restarts.
# Generate manually: openssl rand -base64 32; back up separately from PostgreSQL.
# VIGIRA_GITHUB_APP_MASTER_KEY=
