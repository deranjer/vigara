[Unit]
Description=Vigara host agent
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=vigara-agent
Group=vigara-agent
ExecStart=/usr/local/bin/vigara-agent --config /var/lib/vigara-agent/agent.json run
Restart=always
RestartSec=5
StateDirectory=vigara-agent
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
RestrictAddressFamilies=AF_INET AF_INET6
[Install]
WantedBy=multi-user.target
