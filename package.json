{
  "name": "vigira-monorepo",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "build:web": "turbo run build --filter=@vigira/web",
    "check:web": "turbo run lint typecheck --filter=@vigira/web",
    "docs:dev": "pnpm --filter @vigira/docs start",
    "docs:build": "pnpm --filter @vigira/docs build"
  },
  "devDependencies": {
    "turbo": "^2.5.8"
  }
}
